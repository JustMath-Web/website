{
  "name": "just-math-malaysia",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "build": "sanity build",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "dev": "sanity dev",
    "start": "sanity start",
    "seed": "tsx scripts/seed.ts",
    "seed:dry-run": "tsx scripts/seed.ts --dry-run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/client": "8.0.0",
    "@sanity/vision": "6.9.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanity": "6.9.1",
    "styled-components": "6.5.1"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "6.0.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "tsx": "4.23.11",
    "typescript": "5.9.3"
  },
  "prettier": {
    "bracketSpacing": false,
    "printWidth": 100,
    "semi": false,
    "singleQuote": true
  }
