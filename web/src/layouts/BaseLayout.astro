---
import "../styles/global.css";
import Analytics from "../components/Analytics.astro";
import AnalyticsNoscript from "../components/AnalyticsNoscript.astro";
import { GSC_VERIFICATION_TOKEN } from "../lib/analytics";
import { toSafeJsonLdString } from "../lib/content/jsonLd";
import type { SiteSettings } from "../lib/sanity/types";

interface Props {
	title: string;
	description: string;
	siteSettings: SiteSettings;
	canonicalUrl?: string;
	noindex?: boolean;
	ogImage?: string;
	ogImageAlt?: string;
}

const {
	title,
	description,
	siteSettings,
	canonicalUrl,
	noindex = false,
	ogImage = "/og-default.png",
	ogImageAlt = "Just Math Malaysia wordmark with a ruled measurement spine.",
} = Astro.props;

const baseUrl = Astro.site ?? Astro.url;
const canonical =
	canonicalUrl ?? new URL(Astro.url.pathname, baseUrl).toString();
const absoluteOgImage = new URL(ogImage, baseUrl).toString();

/**
 * Sitewide Organization JSON-LD (guideline §14). Only fields with real, confirmed data — inventing
 * placeholder values would violate the guideline's "no silently invented business-critical content"
 * rule. `sameAs` carries the one verified social profile (owner-supplied 2026-09-22, confirmed live
 * and linking back to this same domain — see the comment on `sameAs` below).
 */
const organizationJsonLd = {
	"@context": "https://schema.org",
	"@type": "Organization",
	name: siteSettings.siteName,
	url: siteSettings.domain,
	telephone: `+${siteSettings.whatsappNumber}`,
	/**
	 * `public/logo.svg` is the exact icon `<svg>` from `LogoLockup.astro` (the site's real mark),
	 * exported standalone with its `fill` hardcoded to the real value of the `ink-900` token (since a
	 * standalone file has no stylesheet to resolve a CSS variable against). It is the icon glyph only
	 * — the "Just Math / MALAYSIA" wordmark next to it in the header is plain CSS-styled text, not
	 * part of this vector. SVG is an explicitly Google-supported image format for structured data
	 * (developers.google.com/search/docs/appearance/google-images#supported-image-formats), and
	 * 512x512 clears the documented 112x112 minimum.
	 */
	logo: {
		"@type": "ImageObject",
		url: new URL("/logo.svg", siteSettings.domain).toString(),
		width: 512,
		height: 512,
	},
	/**
	 * Verified live 2026-09-22 (not merely owner-supplied): the page's own "About" info lists
	 * `mathematicsmalaysia.com` and `kongsf@yahoo.com`, confirming it's this same business's profile.
	 * Its "Intro" and phone number are stale (pre-rebrand pricing, and the `010-658 0242` number
	 * retired per docs/DECISIONS.md §11a) — worth the owner updating on Facebook itself, but doesn't
	 * affect the correctness of this link: `sameAs` asserts identity, not that the linked page's own
	 * content is current.
	 */
	sameAs: ["https://www.facebook.com/JustMathMalaysia"],
};
---

<!doctype html>
<html lang="en-MY">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		{
			/*
			 * Search Console ownership. The property is verified by META TAG and has no DNS TXT
			 * fallback, so this tag is what carries verification — and 16 months of query history —
			 * across the cutover off WordPress. Do not remove. See lib/analytics.ts.
			 */
		}
		<meta name="google-site-verification" content={GSC_VERIFICATION_TOKEN} />
		<link rel="canonical" href={canonical} />
		{noindex && <meta name="robots" content="noindex,nofollow" />}
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={absoluteOgImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={absoluteOgImage} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<script
			is:inline
			type="application/ld+json"
			set:html={toSafeJsonLdString(organizationJsonLd)}
		/>
		<Analytics />
	</head>
	<body>
		<AnalyticsNoscript />
		<a class="skip-link" href="#main">Skip to content</a>
		<slot />
	</body>
</html>

<style is:global>
	.skip-link {
		position: fixed;
		inset-block-start: var(--space-3);
		inset-inline-start: var(--space-3);
		z-index: 100;
		display: inline-flex;
		align-items: center;
		min-height: var(--control-h);
		transform: translateY(calc(-100% - var(--space-5)));
		background: var(--paper);
		color: var(--ink-900);
		border: 2px solid var(--ink-900);
		border-radius: var(--radius-md);
		padding: var(--space-3) var(--space-4);
		font: var(--type-label);
		text-decoration: none;
		transition: transform var(--dur-2) var(--ease-out);
	}

	.skip-link:focus-visible {
		transform: translateY(0);
	}

	@media print {
		.skip-link {
			display: none;
		}
	}

	@media (max-width: 640px) {
		body {
			padding-block-end: calc(
				var(--mobile-cta-bar-h) + env(safe-area-inset-bottom)
			);
		}
	}
</style>
