---
import BaseLayout from "../layouts/BaseLayout.astro";
import GapChart from "../components/GapChart.astro";
import SectionMarker from "../components/SectionMarker.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import WhatsAppCta from "../components/WhatsAppCta.astro";
import { getLandingPageData } from "../lib/content/landingData";
import type { LevelBlock } from "../lib/sanity/types";

const { homePage, siteSettings, navigation, categories } =
	await getLandingPageData();

const pageSeo = homePage.seo ?? siteSettings.defaultSeo;
const pageTitle =
	pageSeo.metaTitle ??
	siteSettings.defaultSeo.metaTitle ??
	siteSettings.siteName;
const pageDescription =
	pageSeo.metaDescription ??
	siteSettings.defaultSeo.metaDescription ??
	homePage.hero.subheadline;
const heroCta = homePage.hero.cta;

function splitParagraphs(value: string | undefined) {
	return (value ?? "")
		.split(/\n{2,}/)
		.map((item) => item.trim())
		.filter(Boolean);
}

function trustParts(text: string) {
	const match = /^([0-9+]+)\s+(.+)$/.exec(text);
	return match
		? { figure: match[1], label: match[2] }
		: { figure: "", label: text };
}

function categoryHref(level: LevelBlock) {
	const category = categories.find((item) => item._id === level.category?._ref);
	return category?.slug?.current
		? `/blog/level/${category.slug.current}/`
		: undefined;
}
---

<BaseLayout
	title={pageTitle}
	description={pageDescription}
	canonicalUrl={pageSeo.canonicalUrl}
	noindex={pageSeo.noindex}
	ogImageAlt={pageSeo.ogImageAlt}
>
	<SiteHeader
		navigation={navigation}
		siteSettings={siteSettings}
		ctaHref={heroCta.href}
	/>
	<main id="main">
		<section
			id="top"
			class="section section--hero graph-ground"
			aria-labelledby="hero-title"
		>
			<div class="hero-grid container">
				<div class="hero-copy">
					<p class="eyebrow">Standard 1 to Form 5 / IGCSE / one to one</p>
					<h1 id="hero-title">{homePage.hero.headline}</h1>
					<p class="hero-lead">{homePage.hero.subheadline}</p>
					<p class="hero-support">{homePage.hero.supportingLine}</p>
					<WhatsAppCta
						href={heroCta.href}
						label={heroCta.label}
						note={homePage.hero.noteUnderButton}
						full
					/>
				</div>
				<aside class="spine-panel" aria-label="Malaysian school years covered">
					<div class="spine-panel__top">
						<span>Every level, one tutor</span>
						<span>11 years</span>
					</div>
					<ol class="spine-list">
						{
							[
								"Standard 1",
								"Standard 2",
								"Standard 3",
								"Standard 4",
								"Standard 5",
								"Standard 6",
								"Form 1",
								"Form 2",
								"Form 3",
								"Form 4",
								"Form 5",
							].map((item) => (
								<li>
									<span aria-hidden="true" />
									{item}
								</li>
							))
						}
					</ol>
					<p>
						IGCSE Mathematics and IGCSE Additional Mathematics, taught to the
						international syllabus rather than translated across from SPM.
					</p>
				</aside>
			</div>
		</section>

		<section
			class="trust-band graph-ground graph-ground--invert"
			aria-label="Teaching experience"
		>
			<div class="trust-grid container">
				{
					homePage.trustItems.map((item) => {
						const stat = trustParts(item.text);
						return stat.figure ? (
							<div class="trust-item">
								<strong>{stat.figure}</strong>
								<span>{stat.label}</span>
							</div>
						) : (
							<p class="trust-item trust-item--line">{stat.label}</p>
						);
					})
				}
			</div>
		</section>

		<section
			id="problem"
			class="section section--ruled"
			aria-labelledby="problem-title"
		>
			<div class="two-column two-column--sticky container">
				<div class="sticky-col">
					<SectionMarker number="01" label="The gap" />
					<h2 id="problem-title">{homePage.problem.heading}</h2>
					<div class="figure-callout">
						<strong>{homePage.problem.independentChecksCount}</strong>
						<span>independent checks in eleven years of schooling</span>
					</div>
					<GapChart annotations={homePage.problem.gapChartAnnotations} />
				</div>
				<div class="prose prose--large">
					{
						splitParagraphs(homePage.problem.body).map((paragraph) => (
							<p>{paragraph}</p>
						))
					}
				</div>
			</div>
		</section>

		<section
			id="sessions"
			class="section section--sunken"
			aria-labelledby="sessions-title"
		>
			<div class="container">
				<SectionMarker number="02" label="One to one" />
				<div class="section-intro">
					<h2 id="sessions-title">{homePage.sessions.heading}</h2>
					<div class="prose prose--lead">
						{
							splitParagraphs(homePage.sessions.body).map((paragraph) => (
								<p>{paragraph}</p>
							))
						}
					</div>
				</div>
				<ul class="session-grid">
					{
						homePage.sessions.subSections.map((section, index) => (
							<li
								class:list={[
									"session-card",
									{ "session-card--wide": index < 2 },
								]}
							>
								<span>{String(index + 1).padStart(2, "0")}</span>
								<h3>{section.heading}</h3>
								<div class="prose prose--small">
									{splitParagraphs(section.body).map((paragraph) => (
										<p>{paragraph}</p>
									))}
								</div>
							</li>
						))
					}
				</ul>
				{
					homePage.sessions.cta && (
						<WhatsAppCta
							href={homePage.sessions.cta.href}
							label={homePage.sessions.cta.label}
							align="center"
						/>
					)
				}
			</div>
		</section>

		<section
			id="levels"
			class="section section--ruled"
			aria-labelledby="levels-label"
		>
			<div class="container">
				<SectionMarker number="03" label="Levels taught" id="levels-label" />
				<ul class="level-list">
					{
						homePage.levels.map((level, index) => (
							<li class="level-row">
								<div class="level-row__heading">
									<span>{String(index + 1).padStart(2, "0")} / 04</span>
									<h2>{level.title}</h2>
									{categoryHref(level) && (
										<a href={categoryHref(level)}>Blog notes</a>
									)}
								</div>
								<div class="level-row__body">
									<p>{level.tagline}</p>
									<ul class="dash-list">
										{level.bullets.map((bullet) => (
											<li>{bullet}</li>
										))}
									</ul>
								</div>
							</li>
						))
					}
				</ul>
				<div class="level-close">
					<p>{homePage.levelsClosingStatement}</p>
				</div>
			</div>
		</section>

		<section
			id="about"
			class="section section--sunken"
			aria-labelledby="about-title"
		>
			<div class="two-column two-column--portrait container">
				<aside
					class="portrait-fallback"
					aria-label="Typographic fallback for Mr Kong portrait"
				>
					<div>
						<span>{homePage.about.byline}</span>
						<strong>{homePage.about.yearsExperience}</strong>
						<p>years teaching every level from Standard 1 to Form 5</p>
					</div>
				</aside>
				<div>
					<SectionMarker number="04" label="The tutor" />
					<h2 id="about-title">{homePage.about.heading}</h2>
					<div class="prose">
						{
							splitParagraphs(homePage.about.body).map((paragraph) => (
								<p>{paragraph}</p>
							))
						}
					</div>
					{
						homePage.about.statPanel && (
							<aside class="ink-panel graph-ground graph-ground--invert">
								<h3>{homePage.about.statPanel.heading}</h3>
								<div class="ink-panel__grid">
									<div class="ink-panel__figure">
										<strong>{homePage.about.studentsPerYear}</strong>
										<span>students a year</span>
									</div>
									<div class="prose prose--invert">
										{splitParagraphs(homePage.about.statPanel.body).map(
											(paragraph) => (
												<p>{paragraph}</p>
											),
										)}
									</div>
								</div>
							</aside>
						)
					}
				</div>
			</div>
		</section>

		<section id="pricing" class="section" aria-labelledby="pricing-title">
			<div class="container">
				<SectionMarker number="05" label="Fees" />
				<div class="section-intro section-intro--bottom">
					<h2 id="pricing-title">{homePage.pricing.heading}</h2>
					<p class="lead">{homePage.pricing.body}</p>
				</div>
				<div class="table-wrap">
					<table>
						<caption> Monthly one-to-one maths tuition fees </caption>
						<colgroup>
							<col class="col-level" />
							<col class="col-session" />
							<col class="col-price" />
							<col class="col-price" />
						</colgroup>
						<thead>
							<tr>
								<th scope="col">Level</th>
								<th scope="col">Session</th>
								<th scope="col">Per month</th>
								<th scope="col">Per session</th>
							</tr>
						</thead>
						<tbody>
							{
								homePage.pricing.pricingRows.map((row) => (
									<tr
										class:list={{
											"pricing-row--highlight": row.sessionLength === "90 min",
										}}
									>
										<th scope="row">{row.level}</th>
										<td>{row.sessionLength}</td>
										<td>{row.perMonth}</td>
										<td>{row.perSession}</td>
									</tr>
								))
							}
						</tbody>
					</table>
				</div>
				<p class="table-note">
					IGCSE runs at 90 minutes because the international syllabus moves
					faster than the national one and an hour a week does not keep pace
					with it.
				</p>
				<div class="pricing-detail">
					<div>
						<h3>Every month includes:</h3>
						<ul class="dash-list">
							{homePage.pricing.includedList.map((item) => <li>{item}</li>)}
						</ul>
						<div class="prose prose--small">
							{
								splitParagraphs(homePage.pricing.paymentNote).map(
									(paragraph) => <p>{paragraph}</p>,
								)
							}
						</div>
					</div>
					{
						homePage.pricing.availability && (
							<aside class="availability-card">
								<h3>{homePage.pricing.availability.heading}</h3>
								<div
									class="time-list"
									aria-label="Available weekday time blocks"
								>
									{(homePage.pricing.availabilityTimeBlocks ?? []).map(
										(block) => (
											<div>
												<strong>{block.range}</strong>
												<span>{block.label}</span>
											</div>
										),
									)}
								</div>
								<div class="prose prose--small">
									{splitParagraphs(homePage.pricing.availability.body).map(
										(paragraph) => (
											<p>{paragraph}</p>
										),
									)}
								</div>
							</aside>
						)
					}
				</div>
				{
					homePage.pricing.cta && (
						<WhatsAppCta
							href={homePage.pricing.cta.href}
							label={homePage.pricing.cta.label}
							align="center"
						/>
					)
				}
			</div>
		</section>

		<section
			id="how"
			class="section section--sunken"
			aria-labelledby="how-title"
		>
			<div class="container">
				<SectionMarker number="06" label="How it works" />
				<h2 id="how-title" class="visually-hidden">How it works</h2>
				<ol class="process-list">
					{
						homePage.processSteps.map((step, index) => (
							<li>
								<span>{String(index + 1).padStart(2, "0")}</span>
								<h3>{step.title}</h3>
								<p>{step.body}</p>
							</li>
						))
					}
				</ol>
			</div>
		</section>

		<section id="faq" class="section" aria-labelledby="faq-label">
			<div class="two-column two-column--faq container">
				<div class="sticky-col">
					<SectionMarker number="07" label="Questions" id="faq-label" />
					<div class="faq-count">
						<strong>{homePage.faqs.length}</strong>
						<span>things parents ask before booking</span>
					</div>
				</div>
				<div>
					<ul class="faq-list">
						{
							homePage.faqs.map((item, index) => (
								<li>
									<details name="faq" open={index === 0}>
										<summary>
											<span>{item.question}</span>
											<i aria-hidden="true" />
										</summary>
										<div class="faq-list__panel">
											<p>{item.answer}</p>
										</div>
									</details>
								</li>
							))
						}
					</ul>
					<WhatsAppCta
						href={heroCta.href}
						label={heroCta.label}
						align="center"
					/>
				</div>
			</div>
		</section>

		<section
			id="start"
			class="section section--close graph-ground graph-ground--invert"
			aria-labelledby="start-title"
		>
			<div class="close-copy container">
				<div class="close-figure">
					<strong>{homePage.finalCta.freeMinutes}</strong>
					<span>minutes, free</span>
				</div>
				<h2 id="start-title">{homePage.finalCta.heading}</h2>
				<div class="prose prose--invert prose--center">
					{
						splitParagraphs(homePage.finalCta.body).map((paragraph) => (
							<p>{paragraph}</p>
						))
					}
				</div>
				<WhatsAppCta
					href={homePage.finalCta.cta.href}
					label={homePage.finalCta.cta.label}
					align="center"
				/>
				<p class="close-note">{homePage.finalCta.smallNote}</p>
			</div>
		</section>
	</main>
	<SiteFooter navigation={navigation} siteSettings={siteSettings} />
</BaseLayout>

<style>
	:root {
		--fluid-hero: clamp(38px, 7.4vw, 84px);
		--fluid-h2: clamp(28px, 4.4vw, 52px);
		--fluid-h3: clamp(19px, 2.3vw, 26px);
		--fluid-lead: clamp(17px, 2vw, 22px);
		--fluid-body: clamp(16px, 1.7vw, 18px);
		--fluid-figure: clamp(52px, 11vw, 132px);
		--fluid-figure-mid: clamp(38px, 6vw, 72px);
		--fluid-figure-sm: clamp(28px, 4vw, 44px);
		--fluid-section-y: clamp(64px, 9vw, 132px);
	}

	.container {
		position: relative;
		max-width: var(--page-max);
		margin: 0 auto;
		padding-inline: clamp(20px, 5vw, var(--gutter));
	}

	.section {
		position: relative;
		overflow: hidden;
		padding-block: var(--fluid-section-y);
		background: var(--paper);
	}

	.section--sunken {
		background: var(--surface-sunken);
	}

	.section--ruled {
		border-top: 1px solid var(--rule);
	}

	.section--hero {
		padding-block: clamp(44px, 7vw, 104px);
	}

	.section--close {
		background: var(--ink-900);
		color: var(--paper);
		text-align: center;
	}

	.graph-ground::before {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background-image:
			linear-gradient(rgba(20, 22, 26, 0.055) 1px, transparent 1px),
			linear-gradient(90deg, rgba(20, 22, 26, 0.055) 1px, transparent 1px);
		background-size: 48px 48px;
		mask-image: linear-gradient(180deg, #000 0%, #000 62%, transparent 100%);
		content: "";
	}

	.graph-ground--invert::before {
		background-image:
			linear-gradient(rgba(251, 250, 247, 0.09) 1px, transparent 1px),
			linear-gradient(90deg, rgba(251, 250, 247, 0.09) 1px, transparent 1px);
	}

	.hero-grid,
	.two-column,
	.section-intro,
	.pricing-detail {
		display: grid;
		gap: clamp(var(--space-6), 6vw, var(--space-9));
	}

	.hero-grid {
		grid-template-columns: minmax(0, 1.55fr) minmax(280px, 0.95fr);
		align-items: start;
	}

	.hero-copy h1 {
		max-width: 15ch;
		margin: 0;
		color: var(--ink-900);
		font: var(--weight-semibold) var(--fluid-hero) / 0.98 var(--font-serif);
		letter-spacing: -0.038em;
		text-wrap: balance;
	}

	.eyebrow {
		margin: 0 0 clamp(20px, 2.6vw, 30px);
		color: var(--text-muted);
		font: var(--type-label);
		letter-spacing: var(--tracking-wide);
		text-transform: uppercase;
	}

	.hero-lead,
	.lead {
		max-width: 44ch;
		color: var(--text-body);
		font: var(--weight-regular) var(--fluid-lead) / 1.5 var(--font-sans);
	}

	.hero-lead {
		margin: clamp(22px, 2.8vw, 32px) 0 0;
	}

	.hero-support,
	.table-note {
		max-width: 44ch;
		margin: var(--space-3) 0 0;
		color: var(--text-muted);
		font: var(--type-small);
	}

	.hero-copy :global(.cta-wrap) {
		margin-top: clamp(30px, 3.6vw, 44px);
	}

	.spine-panel {
		border-top: 3px solid var(--ink-900);
		padding-top: var(--space-5);
	}

	.spine-panel__top {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-3);
		margin-bottom: var(--space-4);
		color: var(--text-muted);
		font: var(--type-label);
		letter-spacing: var(--tracking-wide);
		text-transform: uppercase;
	}

	.spine-panel__top span:last-child {
		color: var(--text-faint);
		font-family: var(--font-mono);
	}

	.spine-list {
		display: grid;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.spine-list li {
		display: grid;
		grid-template-columns: auto 1fr;
		align-items: center;
		gap: var(--space-3);
		border-bottom: 1px solid var(--rule);
		padding-block: 9px;
		color: var(--ink-900);
		font: var(--weight-regular) clamp(13px, 1.5vw, 15px) / 1.2 var(--font-sans);
	}

	.spine-list span {
		width: 12px;
		height: 1px;
		background: var(--ink-900);
	}

	.spine-panel p {
		margin: var(--space-4) 0 0;
		border-top: 2px solid var(--ink-900);
		padding-top: var(--space-4);
		color: var(--text-muted);
		font: var(--type-small);
	}

	.trust-band {
		position: relative;
		overflow: hidden;
		background: var(--ink-900);
		padding-block: clamp(36px, 5vw, 64px);
	}

	.trust-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
	}

	.trust-item {
		display: grid;
		align-content: start;
		gap: var(--space-3);
		border-left: 1px solid rgba(251, 250, 247, 0.18);
		padding-inline: clamp(20px, 2.4vw, 32px);
	}

	.trust-item:first-child {
		border-left: 0;
		padding-left: 0;
	}

	.trust-item strong {
		color: var(--paper);
		font: var(--weight-semibold) var(--fluid-figure-sm) / 0.86 var(--font-mono);
		letter-spacing: -0.045em;
	}

	.trust-item span,
	.trust-item--line {
		max-width: 20ch;
		color: var(--ink-300);
		font: var(--type-small);
	}

	.trust-item--line {
		align-self: center;
		margin: 0;
		color: var(--paper);
		font: var(--weight-regular) clamp(17px, 2vw, 21px) / 1.3 var(--font-serif);
		letter-spacing: -0.01em;
	}

	.two-column {
		grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
		align-items: start;
	}

	.two-column--portrait {
		grid-template-columns: minmax(0, 300px) minmax(0, 1fr);
	}

	.two-column--faq {
		grid-template-columns: minmax(0, 270px) minmax(0, 1fr);
	}

	.sticky-col {
		position: sticky;
		top: 92px;
		display: grid;
		gap: clamp(var(--space-5), 3.2vw, var(--space-7));
	}

	h2 {
		max-width: 21ch;
		margin: clamp(24px, 3vw, 36px) 0 0;
		color: var(--ink-900);
		font: var(--weight-semibold) var(--fluid-h2) / 1.06 var(--font-serif);
		letter-spacing: -0.028em;
		text-wrap: balance;
	}

	h3 {
		margin: 0;
		color: var(--ink-900);
		font: var(--weight-semibold) var(--fluid-h3) / 1.22 var(--font-serif);
		letter-spacing: -0.018em;
	}

	.figure-callout,
	.faq-count,
	.close-figure {
		display: flex;
		align-items: flex-end;
		gap: var(--space-4);
	}

	.figure-callout strong,
	.faq-count strong,
	.close-figure strong {
		color: var(--ink-900);
		font: var(--weight-semibold) var(--fluid-figure) / 0.86 var(--font-mono);
		letter-spacing: -0.045em;
	}

	.figure-callout span,
	.faq-count span,
	.close-figure span {
		max-width: 16ch;
		padding-bottom: 0.6em;
		color: var(--text-muted);
		font: var(--type-small);
	}

	.prose {
		display: grid;
		gap: 1.1em;
		max-width: var(--measure);
	}

	.prose p {
		margin: 0;
		color: var(--text-body);
		font: var(--weight-regular) var(--fluid-body) / 1.62 var(--font-sans);
	}

	.prose--large p {
