---
import { PortableText } from "astro-portabletext";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import WhatsAppCta from "../../components/WhatsAppCta.astro";
import Meta from "../../components/blog/Meta.astro";
import { postBodyComponents } from "../../components/portabletext";
import { getBlogPostData, getBlogPostSlugs } from "../../lib/content/blogData";
import { getLandingPageData } from "../../lib/content/landingData";
import { resolveValidPosts } from "../../lib/content/resolveValidPosts";
import { buildWhatsAppUrl } from "../../lib/content/whatsappUrl";
import type { Post } from "../../lib/sanity/types";

export async function getStaticPaths() {
	const slugs = await getBlogPostSlugs();
	const posts = await Promise.all(
		slugs.map((entry) => getBlogPostData(entry.slug).then((data) => data.post)),
	);
	// Filters out any slug whose individual fetch came back null — see
	// lib/content/resolveValidPosts.ts's comment and docs/DECISIONS.md §30. Passing the already-
	// fetched post via `props` also avoids a second, redundant fetch per page below.
	return resolveValidPosts(slugs, posts).map(({ slug, post }) => ({
		params: { slug },
		props: { post },
	}));
}

interface Props {
	post: Post;
}

const { post } = Astro.props;

// Defensive, even though getStaticPaths' filtering already guarantees this — matches this project's
// "don't assume it can't happen" discipline (docs/DECISIONS.md §30).
if (!post) {
	throw new Error(
		"blog/[slug].astro rendered with no post prop -- getStaticPaths' resolveValidPosts filtering " +
			"should have prevented this route from ever being built.",
	);
}

const { siteSettings, navigation } = await getLandingPageData();
const category = post.categories[0]?.title ?? "";

/**
 * Per-FIELD SEO resolution, deliberately not `post.seo ?? siteSettings.defaultSeo`.
 *
 * `seo` is optional on the post schema, so an object-level fallback handed every unoptimised post
 * the whole site default — which carries a populated `metaTitle`/`metaDescription` — and the
 * per-post fallbacks below could never run. Result: every such post shipped the home page's title
 * and description, so the blog cannibalised itself on the one surface meant to carry long-tail
 * search. `defaultSeo` is now the last resort per field, never the first.
 *
 * `canonicalUrl` and `noindex` resolve from the post alone: inheriting a site-level canonical would
 * point every post at one URL, and indexability is a per-document decision.
 */
const pageTitle =
	post.seo?.metaTitle ?? `${post.title} — Notes — ${siteSettings.siteName}`;
const pageDescription =
	post.seo?.metaDescription ??
	post.excerpt ??
	siteSettings.defaultSeo.metaDescription;

/**
 * BlogPosting JSON-LD, following BaseLayout.astro's own Organization JSON-LD pattern exactly (own
 * script tag, only real-data fields, no invented `image`/etc. when nothing backs it).
 */
const blogPostingJsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: post.title,
	author: { "@type": "Person", name: post.author.name },
	datePublished: post.publishedAt,
	...(post.updatedAt ? { dateModified: post.updatedAt } : {}),
	url: new URL(`/blog/${post.slug.current}/`, siteSettings.domain).toString(),
};
---

<BaseLayout
	title={pageTitle}
	description={pageDescription}
	siteSettings={siteSettings}
	canonicalUrl={post.seo?.canonicalUrl}
	noindex={post.seo?.noindex ?? false}
>
	<script
		is:inline
		type="application/ld+json"
		set:html={JSON.stringify(blogPostingJsonLd)}
	/>
	<SiteHeader
		navigation={navigation}
		siteSettings={siteSettings}
		ctaHref={buildWhatsAppUrl(siteSettings)}
	/>
	<main id="main">
		<section class="section section--hero" aria-labelledby="post-title">
			<div class="container">
				<nav class="breadcrumb" aria-label="Breadcrumb">
					<a class="breadcrumb__link" href="/blog/">Notes</a>
					<span class="breadcrumb__sep" aria-hidden="true">/</span>
					{
						category && (
							<a
								class="breadcrumb__link"
								href={`/blog/level/${post.categories[0].slug.current}/`}
							>
								{category}
							</a>
						)
					}
				</nav>
				<h1 id="post-title">{post.title}</h1>
				<Meta
					category={category}
					publishedAt={post.publishedAt}
					readingTimeMinutes={post.readingTimeMinutes}
				/>
				<p class="lead">{post.excerpt}</p>
			</div>
		</section>

		<section class="section section--ruled">
			<div class="container">
				<div class="prose">
					<PortableText value={post.body} components={postBodyComponents} />
				</div>
				<div class="post-cta">
					<WhatsAppCta
						href={buildWhatsAppUrl(siteSettings)}
						label={siteSettings.primaryCtaLabel}
					/>
				</div>
			</div>
		</section>
	</main>
	<SiteFooter navigation={navigation} siteSettings={siteSettings} />
</BaseLayout>

<style>
	.container {
		max-width: var(--page-max);
		margin: 0 auto;
		padding-inline: clamp(20px, 5vw, var(--gutter));
	}

	.section {
		padding-block: clamp(64px, 9vw, 132px);
		background: var(--paper);
	}

	.section--hero {
		padding-block: clamp(44px, 7vw, 104px) clamp(32px, 4vw, 48px);
	}

	.section--ruled {
		border-top: 1px solid var(--rule);
	}

	.breadcrumb {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		margin-bottom: var(--space-4);
		font: var(--type-small);
	}

	.breadcrumb__link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: var(--control-h);
		min-width: var(--control-h);
		margin-block: calc((var(--control-h) - 1.2em) / -2);
		padding-inline: var(--space-2);
		margin-inline: calc(var(--space-2) * -1);
		color: var(--text-muted);
		text-decoration: none;
	}

	.breadcrumb__link:hover {
		text-decoration: underline;
	}

	.breadcrumb__sep {
		color: var(--text-faint);
	}

	h1 {
		max-width: 20ch;
		margin: 0 0 var(--space-4);
		color: var(--ink-900);
		font: var(--weight-semibold) clamp(32px, 5vw, 52px) / 1.1 var(--font-serif);
	}

	.lead {
		max-width: var(--measure-narrow);
		margin: var(--space-4) 0 0;
		color: var(--text-muted);
		font: var(--weight-regular) clamp(17px, 2vw, 22px) / 1.5 var(--font-sans);
	}

	.prose {
		max-width: var(--measure);
		margin: 0 auto;
		font: var(--type-body);
		color: var(--text-body);
	}

	.prose :global(h2) {
		margin-top: var(--space-7);
		font: var(--weight-semibold) var(--fluid-h3, clamp(22px, 2.8vw, 30px)) /
			1.25 var(--font-serif);
		color: var(--ink-900);
	}

	.prose :global(h3) {
		margin-top: var(--space-6);
		font: var(--weight-semibold) clamp(19px, 2.2vw, 23px) / 1.3
			var(--font-serif);
		color: var(--ink-900);
	}

	.prose :global(p) {
		margin: var(--space-4) 0 0;
	}

	.post-cta {
		max-width: var(--measure);
		margin: var(--space-7) auto 0;
		padding-top: var(--space-6);
		border-top: 3px solid var(--ink-900);
	}
</style>
