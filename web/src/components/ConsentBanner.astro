---
/**
 * One-step Google measurement choice, Malay and English together (Act 709 s.7(3)). Hidden in the
 * HTML and shown by `public/consent.js` only when no valid choice is stored, so a visitor without
 * JavaScript sees nothing and is not tracked. Equal buttons, no pre-ticked box
 * (docs/DECISIONS.md §49).
 *
 * Wording gate: the advertising-features sentence and the Malay text must be confirmed against GTM
 * container GTM-KP5SMKV / GA4 and a native Malay review before release (see docs/DECISIONS.md §49).
 */
---

<div
	id="consent-banner"
	class="consent"
	role="region"
	aria-label="Cookie choice / Pilihan kuki"
	hidden
>
	<p class="consent__text" lang="en">
		With your OK we use Google Analytics to count visits and understand how the
		site is used. Google may also use this data for its advertising features.
		Google Analytics and these advertising features load only if you accept.
		{" "}<a href="/privacy/">Privacy notice</a>
	</p>
	<p class="consent__text" lang="ms">
		Dengan persetujuan anda, kami guna Google Analytics untuk mengira lawatan
		dan memahami cara laman web digunakan. Google juga boleh menggunakan data
		ini untuk ciri pengiklanannya. Google Analytics dan ciri pengiklanan ini
		hanya dimuatkan jika anda bersetuju.
		{" "}<a href="/privacy/">Notis privasi</a>
	</p>
	<div class="consent__actions">
		<button type="button" class="consent__btn" data-consent="accept">
			Accept / Terima
		</button>
		<button type="button" class="consent__btn" data-consent="reject">
			Reject / Tolak
		</button>
	</div>
</div>

<style>
	.consent {
		position: fixed;
		inset-inline: 0;
		/* Sits above the fixed mobile WhatsApp bar; consent.js sets --consent-offset to its height. */
		inset-block-end: var(--consent-offset, 0px);
		z-index: 50;
		display: grid;
		gap: var(--space-3);
		max-height: 50vh;
		overflow-y: auto;
		padding: var(--space-4) clamp(20px, 5vw, var(--gutter));
		background: var(--ink-900);
		color: var(--paper);
		border-top: 1px solid var(--ink-300);
	}

	.consent[hidden] {
		display: none;
	}

	.consent__text {
		margin: 0;
		font: var(--type-small);
		max-width: 70ch;
	}

	.consent__text a {
		/* Holds the gap even if the compiler collapses the space before the link. */
		margin-inline-start: 0.25em;
		color: inherit;
		text-decoration: underline;
	}

	.consent__actions {
		display: flex;
		gap: var(--space-3);
	}

	.consent__btn {
		flex: 1 1 0;
		min-height: 44px;
		padding: var(--space-2) var(--space-4);
		border: 1px solid currentColor;
		background: transparent;
		color: inherit;
		font: var(--type-small);
		cursor: pointer;
	}

	.consent__btn:focus-visible {
		outline: 2px solid var(--ochre-500);
		outline-offset: 2px;
	}
</style>
