---
interface Props {
	invert?: boolean;
}

const { invert = false } = Astro.props;
const fill = invert ? "var(--paper)" : "var(--ink-900)";
const muted = invert ? "var(--ink-300)" : "var(--ink-500)";
// Header and footer both render a lockup on the same page, so each variant gets its own mask id.
const cutId = invert ? "logo-cut-invert" : "logo-cut";
---

<span
	class="logo-lockup"
	aria-label="Just Math Malaysia"
	style={`color:${fill}`}
>
	{
		/*
		 * The mark: a square-root sign. Its lowest point is cut away in a circle (the gap from an
		 * earlier year) and the ochre dot sits in the cut (the fix). Geometry from the approved logo
		 * canvas (claude.ai design artifact, "The mark" board). public/logo.svg and
		 * public/favicon.svg carry the same shape as standalone files.
		 */
	}
	<svg
		viewBox="0 -4 124 108"
		width="2.6em"
		height="2.26em"
		aria-hidden="true"
		focusable="false"
	>
		<defs>
			<mask
				id={cutId}
				maskUnits="userSpaceOnUse"
				x="0"
				y="-4"
				width="124"
				height="108"
			>
				<rect x="0" y="-4" width="124" height="108" fill="#fff"></rect>
				<circle cx="40" cy="92" r="13.5" fill="#000"></circle>
			</mask>
		</defs>
		<g
			mask={`url(#${cutId})`}
			fill="none"
			stroke="currentColor"
			stroke-width="9"
			stroke-linejoin="round"
			stroke-linecap="round"
		>
			<path d="M6 55 L22 46 L40 92"></path>
			<path d="M40 92 L62 8 L118 8"></path>
		</g>
		<circle cx="40" cy="92" r="7.5" fill="var(--ochre-500)"></circle>
	</svg>
	<span class="logo-lockup__type">
		<span class="logo-lockup__name">Just Math</span>
		<span class="logo-lockup__country lockup-fill" style={`color:${muted}`}
			>MALAYSIA</span
		>
	</span>
</span>

<style>
	.logo-lockup {
		display: inline-flex;
		align-items: center;
		gap: 0.45em;
		font-size: clamp(1rem, 2vw, 1.25rem);
		text-decoration: none;
	}

	.logo-lockup svg {
		display: block;
		flex: none;
	}

	.logo-lockup__type {
		display: inline-flex;
		align-items: stretch;
		flex-direction: column;
		gap: 0.45em;
		font-size: 1em;
	}

	.logo-lockup__name {
		color: inherit;
		font: var(--weight-semibold) 1em/1 var(--font-serif);
		letter-spacing: var(--tracking-tight);
		white-space: nowrap;
	}

	.logo-lockup__country {
		font: var(--weight-medium) 0.6em/1 var(--font-sans);
		letter-spacing: 0.24em;
	}
</style>
