---
import LogoLockup from "./LogoLockup.astro";
import type { Navigation, SiteSettings } from "../lib/sanity/types";

interface Props {
	navigation: Navigation;
	siteSettings: SiteSettings;
}

const { navigation, siteSettings } = Astro.props;
---

<footer class="site-footer">
	<div class="site-footer__inner">
		<div class="site-footer__brand">
			<LogoLockup invert />
			<p>
				One-to-one online maths tuition across Malaysia, taught in English and
				Bahasa Melayu.
			</p>
		</div>
		<nav class="site-footer__nav" aria-label="Footer navigation">
			<ul class="site-footer__list">
				{
					navigation.footerLinks.map((item) => (
						<li>
							<a href={item.href} class="site-footer__link">
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
		<div class="site-footer__contact">
			<span>WhatsApp {siteSettings.phoneDisplay}</span>
			<span>{new URL(siteSettings.domain).hostname}</span>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--ink-900);
		color: var(--ink-300);
		padding-block: var(--space-8);
	}

	.site-footer__inner {
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(180px, 0.6fr) minmax(
				180px,
				0.6fr
			);
		gap: var(--space-7);
		max-width: var(--page-max);
		margin: 0 auto;
		padding-inline: clamp(20px, 5vw, var(--gutter));
	}

	.site-footer__brand {
		display: grid;
		gap: var(--space-4);
	}

	.site-footer__brand p {
		max-width: 34ch;
		margin: 0;
		color: var(--ink-300);
		font: var(--type-small);
	}

	.site-footer__contact {
		display: grid;
		align-content: start;
		gap: var(--space-3);
	}

	.site-footer__list {
		display: grid;
		align-content: start;
		gap: var(--space-3);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.site-footer__link {
		display: flex;
		align-items: center;
		min-height: var(--control-h);
		margin-block: -13px;
		color: var(--paper);
		font: var(--weight-medium) var(--size-xs) / 1.3 var(--font-sans);
		text-decoration-color: rgba(251, 250, 247, 0.3);
	}

	.site-footer__link:hover {
		color: var(--paper);
		text-decoration-color: var(--paper);
	}

	.site-footer__contact {
		color: var(--ink-300);
		font: var(--type-small);
	}

	@media (max-width: 760px) {
		.site-footer__inner {
			grid-template-columns: 1fr;
			gap: var(--space-6);
		}
	}
</style>
