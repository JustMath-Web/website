---
import Meta from "./Meta.astro";
import type { PostSummary } from "../../lib/sanity/types";

interface Props {
	post: PostSummary;
}

const { post } = Astro.props;
const category = post.categories[0]?.title ?? "";
---

<article class="post-row">
	<a class="post-row__link" href={`/blog/${post.slug.current}/`}>
		<div class="post-row__meta">
			<Meta
				category={category}
				publishedAt={post.publishedAt}
				readingTimeMinutes={post.readingTimeMinutes}
				stack
			/>
		</div>
		<div class="post-row__body">
			<h2 class="post-row__title">{post.title}</h2>
			<p class="post-row__excerpt">{post.excerpt}</p>
		</div>
	</a>
</article>

<style>
	.post-row {
		border-top: 1px solid var(--rule);
	}

	.post-row:last-child {
		border-bottom: 1px solid var(--rule);
	}

	.post-row__link {
		display: block;
		padding: clamp(var(--space-5), 3vw, var(--space-6)) 0;
		color: inherit;
		text-decoration: none;
	}

	.post-row__title {
		max-width: 26ch;
		margin: 0 0 var(--space-2);
		color: var(--ink-900);
		font: var(--weight-semibold) clamp(22px, 2.6vw, 31px) / 1.2
			var(--font-serif);
		text-wrap: balance;
	}

	.post-row__link:hover .post-row__title {
		text-decoration: underline;
	}

	.post-row__excerpt {
		max-width: 56ch;
		margin: 0;
		color: var(--text-muted);
		font: var(--type-body);
	}

	@media (min-width: 768px) {
		.post-row__link {
			display: grid;
			grid-template-columns: minmax(0, 220px) minmax(0, 1fr);
			gap: var(--space-6);
			align-items: start;
		}
	}
</style>
