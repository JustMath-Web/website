---
const stops = [
	"S1",
	"S2",
	"S3",
	"S4",
	"S5",
	"S6",
	"F1",
	"F2",
	"F3",
	"F4",
	"F5",
];
const measured: Record<number, string> = {
	3: "OCT 2026",
	8: "FROM 2027",
	10: "SPM",
};
---

<figure class="gap-chart" aria-labelledby="gap-chart-title">
	<div class="gap-chart__grid" aria-hidden="true"></div>
	<div class="gap-chart__content">
		<div class="gap-chart__header">
			<figcaption id="gap-chart-title">When maths is measured</figcaption>
			<span>3 points / 11 years</span>
		</div>
		<div class="gap-chart__flags" aria-hidden="true">
			{
				stops.map((_, index) => (
					<span>
						{measured[index] ? measured[index].replace(" ", "\u00a0") : ""}
					</span>
				))
			}
		</div>
		<div class="gap-chart__bars" aria-hidden="true">
			{
				stops.map((stop, index) => (
					<span
						class:list={[
							"gap-chart__bar",
							{ "gap-chart__bar--measured": measured[index] },
						]}
					>
						<i>{stop}</i>
					</span>
				))
			}
		</div>
		<div class="gap-chart__axis" aria-hidden="true">
			{
				stops.map((stop, index) => (
					<span class:list={{ "gap-chart__axis-measured": measured[index] }}>
						{stop}
					</span>
				))
			}
		</div>
		<div class="gap-chart__bracket" aria-hidden="true">
			<span>No measure</span>
		</div>
		<p>
			Standard 1, 2, 3, 5, 6 and Form 1, 2, 4 are never independently measured.
			Form 3 to SPM is the longest unchecked stretch, and the one Additional
			Mathematics arrives in.
		</p>
	</div>
</figure>

<style>
	.gap-chart {
		position: relative;
		overflow: hidden;
		margin: 0;
		border-radius: var(--radius-lg);
		background: var(--ink-900);
		padding: clamp(22px, 3vw, 34px);
	}

	.gap-chart__grid {
		position: absolute;
		inset: 0;
		opacity: 0.8;
		background-image:
			linear-gradient(rgba(251, 250, 247, 0.09) 1px, transparent 1px),
			linear-gradient(90deg, rgba(251, 250, 247, 0.09) 1px, transparent 1px);
		background-size: 32px 32px;
		mask-image: linear-gradient(180deg, #000 0%, #000 62%, transparent 100%);
	}

	.gap-chart__content {
		position: relative;
	}

	.gap-chart__header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-3);
		margin-bottom: clamp(20px, 2.6vw, 30px);
	}

	.gap-chart figcaption {
		color: var(--ink-400);
		font: var(--type-label);
		letter-spacing: var(--tracking-wide);
		text-transform: uppercase;
	}

	.gap-chart__header span {
		color: var(--ochre-500);
		font: var(--weight-semibold) var(--size-2xs) / 1 var(--font-mono);
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.gap-chart__flags,
	.gap-chart__axis,
	.gap-chart__bars {
		display: grid;
		grid-template-columns: repeat(11, minmax(0, 1fr));
		gap: 3px;
	}

	.gap-chart__flags {
		align-items: end;
		height: 30px;
	}

	.gap-chart__flags span {
		color: var(--ochre-500);
		font: var(--weight-semibold) var(--size-3xs) / 1.2 var(--font-mono);
		letter-spacing: 0.02em;
		text-align: center;
		white-space: nowrap;
	}

	.gap-chart__bars {
		align-items: end;
		height: clamp(96px, 14vw, 150px);
		border-bottom: 2px solid var(--paper);
	}

	.gap-chart__bar {
		display: flex;
		align-items: flex-end;
		justify-content: center;
		height: 100%;
	}

	.gap-chart__bar::before {
		display: block;
		width: 100%;
		max-width: 22px;
		height: 14%;
		background: rgba(251, 250, 247, 0.22);
		content: "";
	}

	.gap-chart__bar--measured::before {
		max-width: 34px;
		height: 100%;
		background: var(--paper);
	}

	.gap-chart__bar i {
		position: absolute;
		clip: rect(0 0 0 0);
		clip-path: inset(50%);
		width: 1px;
		height: 1px;
		overflow: hidden;
		white-space: nowrap;
	}

	.gap-chart__axis {
		margin-top: 10px;
	}

	.gap-chart__axis span {
		color: rgba(251, 250, 247, 0.55);
		font: var(--weight-regular) var(--size-2xs) / 1 var(--font-mono);
		text-align: center;
	}

	.gap-chart__axis .gap-chart__axis-measured {
		color: var(--paper);
		font-weight: var(--weight-semibold);
	}

	.gap-chart__bracket {
		display: grid;
		grid-template-columns: repeat(11, minmax(0, 1fr));
		gap: 3px;
		margin-top: var(--space-3);
	}

	.gap-chart__bracket span {
		grid-column: 10 / 12;
		border-top: 1px solid var(--ochre-500);
		padding-top: var(--space-2);
		color: var(--ochre-500);
		font: var(--weight-medium) var(--size-3xs) / 1.3 var(--font-mono);
		letter-spacing: 0.02em;
		text-align: center;
		text-transform: uppercase;
	}

	.gap-chart p {
		margin: var(--space-5) 0 0;
		border-top: 1px solid rgba(251, 250, 247, 0.18);
		padding-top: var(--space-4);
		color: var(--ink-300);
		font: var(--type-small);
	}
</style>
