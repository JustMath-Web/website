---
import LogoLockup from "./LogoLockup.astro";
import WhatsAppCta from "./WhatsAppCta.astro";
import type { Navigation, SiteSettings } from "../lib/sanity/types";

interface Props {
	navigation: Navigation;
	siteSettings: SiteSettings;
	ctaHref: string;
}

const { navigation, siteSettings, ctaHref } = Astro.props;
---

<header class="site-header">
	<div class="site-header__inner">
		<a
			class="site-header__brand"
			href="/"
			aria-label={`${siteSettings.siteName} home`}
		>
			<LogoLockup />
		</a>
		<nav class="site-header__nav" aria-label="Primary navigation">
			{
				navigation.headerLinks.map((item) => (
					<a class="site-header__link" href={item.href}>
						{item.label}
					</a>
				))
			}
		</nav>
		<WhatsAppCta href={ctaHref} label={siteSettings.headerCtaLabel} size="md" />
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		border-bottom: 1px solid var(--rule);
		background: rgba(251, 250, 247, 0.92);
		backdrop-filter: blur(10px);
	}

	.site-header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: clamp(var(--space-3), 2.5vw, var(--space-5));
		min-height: 62px;
		max-width: var(--page-max);
		margin: 0 auto;
		padding-inline: clamp(20px, 5vw, var(--gutter));
	}

	.site-header__brand {
		color: var(--ink-900);
		text-decoration: none;
	}

	.site-header__brand:hover {
		color: var(--ink-900);
		text-decoration: none;
	}

	.site-header__nav {
		display: inline-flex;
		align-items: center;
		gap: var(--space-3);
		margin-inline-start: auto;
	}

	.site-header__link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: var(--control-h);
		min-height: var(--control-h);
		margin-inline: -4px;
		color: var(--ink-700);
		font: var(--weight-medium) var(--size-xs) / 1 var(--font-sans);
		text-decoration: none;
		white-space: nowrap;
	}

	.site-header__link:hover {
		color: var(--ink-900);
		text-decoration: underline;
		text-decoration-thickness: 2px;
	}

	@media (max-width: 560px) {
		.site-header__inner {
			gap: var(--space-3);
		}
	}
</style>
