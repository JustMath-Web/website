# Sanity project connection (docs/DECISIONS.md §6). PUBLIC_ vars are exposed to the browser bundle
# by Astro/Vite convention — never put a write or draft-enabled token behind that prefix.
PUBLIC_SANITY_PROJECT_ID=v4v0i7gl
PUBLIC_SANITY_DATASET=production

# Optional. Only needed if the "production" dataset is private. Server-only: never reference this
# with a PUBLIC_ prefix. Viewer/read scope only — never a write token in this app.
#
# Setting this alone does NOT enable draft reads — lib/sanity/client.ts's default `sanityClient`
# always reads perspective:"published", token or not (Bob P1-DEV-01: a token must only ever be an
# auth concern, never an implicit switch to draft content in a production build). Draft/preview
# reads require BOTH this token AND ENABLE_SANITY_PREVIEW=true, via the separate
# createPreviewClient() — never through sanityClient.
SANITY_API_READ_TOKEN=

# Must be the exact string "true" to opt into draft reads via createPreviewClient(). Not wired to
# any route yet — no preview mode exists in this scaffold. Leave unset/false in production.
ENABLE_SANITY_PREVIEW=

# Deployment sentinel used by blogData.ts. Set to "production" only in the Cloudflare Pages
# production environment; leave unset for local development and preview builds.
DEPLOY_ENV=
